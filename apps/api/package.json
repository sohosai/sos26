{
  "name": "@sos26/api",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "bun --env-file=../../.env run --hot src/index.ts",
    "build": "bun run typecheck && bun build src/index.ts --outdir dist --target bun --external sharp",
    "preview": "bun run dist/index.js",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist .turbo",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate:dev": "bun --env-file=../../.env run prisma migrate dev",
    "db:migrate:deploy": "bun --env-file=../../.env run prisma migrate deploy",
    "db:migrate:reset": "bun --env-file=../../.env run prisma migrate reset",
    "db:push": "bun --env-file=../../.env run prisma db push",
    "db:pull": "bun --env-file=../../.env run prisma db pull",
    "db:studio": "bun --env-file=../../.env run prisma studio",
    "db:format": "prisma format",
    "make-committee-member": "bun --env-file=../../.env run scripts/make-committee-member.ts",
    "db:seed": "bun --env-file=../../.env run scripts/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.988.0",
    "@aws-sdk/s3-request-presigner": "^3.988.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "@prisma/client": "^6.8.2",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/bun": "^10.43.0",
    "@sos26/shared": "workspace:*",
    "archiver": "^7.0.1",
    "firebase-admin": "^13.6.0",
    "hono": "^4.11.3",
    "isomorphic-dompurify": "^2.36.0",
    "p-limit": "^7.3.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.8.2",
    "prisma-markdown": "^4.0.0"
  }
}
