VITE_API_BASE_URL=http://localhost:3000

# Firebase
# ローカル開発では compose.yml の Firebase Auth Emulator を使う（API キーは任意の文字列でよい）
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-sos26
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
# 本物の Firebase を使う場合は apps/web/.env に以下を設定
# エミュレータを無効化するためには、接続先を空文字で上書きする
# VITE_FIREBASE_AUTH_EMULATOR_URL=
# VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id

# Sentry（エラー監視、任意）
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_AUTH_TOKEN=
# VITE_SENTRY_ORG=
# VITE_SENTRY_PROJECT=

# Push通知
# API の VAPID_PUBLIC_KEY と一致させる必要がある
VITE_VAPID_PUBLIC_KEY=
